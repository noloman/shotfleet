# Shared settings for every clip's tape. VHS runs in the session folder (session.sh); `rc` sets PATH, the prompt and cd myapp.
Set Shell "bash"
Set Width 1600
Set Height 880
Set FontSize 30
Set Padding 36
Set TypingSpeed 40ms
Set CursorBlink false
Set Theme { "name": "shotfleet", "background": "#0b1220", "foreground": "#dbe6f3", "cursor": "#dbe6f3", "selection": "#24344a", "black": "#0b1220", "red": "#ff6b6b", "green": "#4ed17a", "yellow": "#f5c400", "blue": "#6ea8ff", "magenta": "#c792ea", "cyan": "#5fd7d7", "white": "#dbe6f3", "brightBlack": "#7f93ab", "brightRed": "#ff8787", "brightGreen": "#7ee2a0", "brightYellow": "#ffd84d", "brightBlue": "#9cc2ff", "brightMagenta": "#dcb6f5", "brightCyan": "#8fe8e8", "brightWhite": "#ffffff" }
Hide
Type "source rc && clear"
Enter
Sleep 800ms
Show
