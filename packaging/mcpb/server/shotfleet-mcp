#!/bin/sh
# Starts `shotfleet mcp` (stdio). The bundle holds no shotfleet program: it uses the one the user installed.
# Claude Desktop starts with a short PATH (no Homebrew, no ~/.local/bin), so look where the installer puts the link.
[ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ] || { echo "shotfleet runs on macOS with Apple silicon (M1 or newer) only" >&2; exit 1; }
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin"
for sf in "$(command -v shotfleet 2>/dev/null)" "$HOME/Library/Application Support/shotfleet/app/shotfleet"; do
  [ -n "$sf" ] && [ -x "$sf" ] && exec "$sf" mcp
done
echo "shotfleet is not installed on this Mac. Install it in Terminal: curl -fsSL https://shotfleet.com/install.sh | sh" >&2
echo "then restart this app. shotfleet.com has the details." >&2
exit 127
